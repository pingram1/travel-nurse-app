EXPO_PUBLIC_API_BASE_URL=https://api.travelnurse.dev/v1

# Optional client-side Places key (prefer proxying via EXPO_PUBLIC_API_BASE_URL /lodging/nearby)
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
# Default departure airport for flight search (tax-home market)
EXPO_PUBLIC_DEFAULT_ORIGIN_AIRPORT=AUS

# Weekly client progress report (scripts/generateWeeklyReport.ts)
REPORT_CLIENT_EMAIL=client@kr2group.com
REPORT_CC_EMAILS=pm@kr2group.com,dev@startrighttutoring.com
EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Travel Nurse Reports <reports@yourdomain.com>
REPORT_CLIENT_NAME=KR2 Group
REPORT_PROJECT_NAME=Travel Nurse Logistics & Safety App
REPORT_DEVELOPER_NAME=Start Right Tutoring, LLC
# Set to "true" to generate the report without sending email
REPORT_DRY_RUN=false
